{
    "name": "perfectdayllc/twilio-a2p-bundle",
    "description": "Usage for Twilio A2P 10-DLC Integrations",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Matias Hernan Lauriti",
            "email": "matias.lauriti@rockstarcoders.com"
        }
    ],
    "require": {
        "php": "^8.0.2",
        "illuminate/bus": "^9|^10",
        "illuminate/console": "^9|^10",
        "illuminate/contracts": "^9|^10",
        "illuminate/database": "^9|^10",
        "illuminate/queue": "^9|^10",
        "illuminate/support": "^9|^10",
        "twilio/sdk": "^6.15"
    },
    "require-dev": {
        "doctrine/dbal": "^3.1.2",
        "laravel/legacy-factories": "^1.1",
        "mockery/mockery": "^1.4.4",
        "orchestra/testbench": "^7|^8",
        "phpunit/phpunit": "^9.5.10"
    },
    "autoload": {
        "psr-4": {
            "PerfectDayLlc\\TwilioA2PBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "files": [
            "tests/helpers.php"
        ],
        "psr-4": {
            "PerfectDayLlc\\TwilioA2PBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PerfectDayLlc\\TwilioA2PBundle\\TwilioA2PBundleServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
